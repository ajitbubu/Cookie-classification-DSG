 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Cookie Classification Model Training\\n",
    "\\n",
    "Train ML models to classify cookies - 100k dataset\\n",
    "\\n",
    "**Time:** 10-15 minutes with GPU"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Upload CSV Files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\\n",
    "import os\\n",
    "\\n",
    "print(\\"📤 Upload your CSV files\\")\\n",
    "print(\\"Select BOTH files:\\")\\n",
    "print(\\"  - cookie_training_100k_train_80.csv\\")\\n",
    "print(\\"  - cookie_training_100k_test_20.csv\\")\\n",
    "\\n",
    "uploaded = files.upload()\\n",
    "\\n",
    "if 'cookie_training_100k_train_80.csv' in uploaded and 'cookie_training_100k_test_20.csv' in uploaded:\\n",
    "    DATA_DIR = '/content'\\n",
    "    print(f\\"\\\\n✅ Files uploaded!\\")\\n",
    "    print(f\\"✅ Training: {len(uploaded['cookie_training_100k_train_80.csv']):,} bytes\\")\\n",
    "    print(f\\"✅ Test: {len(uploaded['cookie_training_100k_test_20.csv']):,} bytes\\")\\n",
    "else:\\n",
    "    print(\\"\\\\n❌ Missing files!\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q scikit-learn xgboost imbalanced-learn pandas numpy matplotlib seaborn\\n",
    "print(\\"✅ Dependencies installed!\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\\n",
    "import numpy as np\\n",
    "import joblib\\n",
    "import json\\n",
    "from datetime import datetime\\n",
    "from pathlib import Path\\n",
    "from sklearn.model_selection import train_test_split\\n",
    "from sklearn.ensemble import RandomForestClassifier\\n",
    "from sklearn.preprocessing import LabelEncoder\\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report, confusion_matrix\\n",
    "from imblearn.over_sampling import SMOTE\\n",
    "import xgboost as xgb\\n",
    "import matplotlib.pyplot as plt\\n",
    "import seaborn as sns\\n",
    "print(\\"✅ Libraries imported!\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_df = pd.read_csv(f\\"{DATA_DIR}/cookie_training_100k_train_80.csv\\")\\n",
    "test_df = pd.read_csv(f\\"{DATA_DIR}/cookie_training_100k_test_20.csv\\")\\n",
    "print(f\\"📊 Train: {len(train_df):,} | Test: {len(test_df):,}\\")\\n",
    "train_df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Explore Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"Class distribution:\\")\\n",
    "print(train_df['label_category'].value_counts())\\n",
    "plt.figure(figsize=(10, 6))\\n",
    "train_df['label_category'].value_counts().plot(kind='bar')\\n",
    "plt.title('Cookie Category Distribution')\\n",
    "plt.xlabel('Category')\\n",
    "plt.ylabel('Count')\\n",
    "plt.xticks(rotation=45, ha='right')\\n",
    "plt.tight_layout()\\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Prepare Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "feature_columns = ['expiry_days', 'secure', 'http_only', 'is_third_party', 'cookie_name_len', 'is_ga_like', 'is_fb_like', 'has_prefix_utm', 'has_consent_kw', 'has_session_kw']\\n",
    "bool_columns = ['secure', 'http_only', 'is_third_party', 'is_ga_like', 'is_fb_like', 'has_prefix_utm', 'has_consent_kw', 'has_session_kw']\\n",
    "for col in bool_columns:\\n",
    "    train_df[col] = train_df[col].astype(int)\\n",
    "    test_df[col] = test_df[col].astype(int)\\n",
    "X_train = train_df[feature_columns].values\\n",
    "y_train = train_df['label_category'].values\\n",
    "X_test = test_df[feature_columns].values\\n",
    "y_test = test_df['label_category'].values\\n",
    "print(f\\"✅ Features: {X_train.shape} | Test: {X_test.shape}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Encode Labels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "label_encoder = LabelEncoder()\\n",
    "y_train_encoded = label_encoder.fit_transform(y_train)\\n",
    "y_test_encoded = label_encoder.transform(y_test)\\n",
    "print(f\\"✅ Categories: {list(label_encoder.classes_)}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 8: Create Validation Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train_split, X_val, y_train_split, y_val = train_test_split(X_train, y_train_encoded, test_size=0.15, stratify=y_train_encoded, random_state=42)\\n",
    "print(f\\"📊 Train: {len(X_train_split):,} | Val: {len(X_val):,} | Test: {len(X_test):,}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 9: Balance Classes with SMOTE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"⚖️  Balancing classes...\\")\\n",
    "smote = SMOTE(random_state=42)\\n",
    "X_train_balanced, y_train_balanced = smote.fit_resample(X_train_split, y_train_split)\\n",
    "print(f\\"✅ Balanced: {len(X_train_split):,} → {len(X_train_balanced):,}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 10: Train Random Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"🌲 Training Random Forest...\\")\\n",
    "rf_model = RandomForestClassifier(n_estimators=100, max_depth=15, min_samples_split=15, min_samples_leaf=8, max_features='sqrt', max_samples=0.8, class_weight='balanced', random_state=42, n_jobs=-1, verbose=1)\\n",
    "rf_model.fit(X_train_balanced, y_train_balanced)\\n",
    "val_acc_rf = accuracy_score(y_val, rf_model.predict(X_val))\\n",
    "print(f\\"✅ RF Validation Accuracy: {val_acc_rf:.4f}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 11: Train XGBoost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"🚀 Training XGBoost...\\")\\n",
    "xgb_model = xgb.XGBClassifier(objective='multi:softprob', num_class=len(label_encoder.classes_), max_depth=6, learning_rate=0.03, n_estimators=500, subsample=0.7, colsample_bytree=0.7, min_child_weight=5, gamma=0.2, reg_alpha=0.3, reg_lambda=2.0, random_state=42, tree_method='hist', eval_metric=['mlogloss', 'merror'], early_stopping_rounds=30)\\n",
    "xgb_model.fit(X_train_balanced, y_train_balanced, eval_set=[(X_train_balanced, y_train_balanced), (X_val, y_val)], verbose=True)\\n",
    "val_acc_xgb = accuracy_score(y_val, xgb_model.predict(X_val))\\n",
    "print(f\\"✅ XGB Validation Accuracy: {val_acc_xgb:.4f}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 12: Evaluate Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def eval_model(model, X, y, name):\\n",
    "    y_pred = model.predict(X)\\n",
    "    acc = accuracy_score(y, y_pred)\\n",
    "    prec = precision_score(y, y_pred, average='weighted', zero_division=0)\\n",
    "    rec = recall_score(y, y_pred, average='weighted', zero_division=0)\\n",
    "    f1 = f1_score(y, y_pred, average='weighted', zero_division=0)\\n",
    "    print(f\\"\\\\n{'='*70}\\")\\n",
    "    print(f\\"{name} - Test Results\\")\\n",
    "    print(f\\"{'='*70}\\")\\n",
    "    print(f\\"Accuracy:  {acc:.4f}\\")\\n",
    "    print(f\\"Precision: {prec:.4f}\\")\\n",
    "    print(f\\"Recall:    {rec:.4f}\\")\\n",
    "    print(f\\"F1-Score:  {f1:.4f}\\")\\n",
    "    print(f\\"\\\\nPer-Class Metrics:\\")\\n",
    "    print(classification_report(y, y_pred, target_names=label_encoder.classes_, zero_division=0))\\n",
    "    cm = confusion_matrix(y, y_pred)\\n",
    "    plt.figure(figsize=(10, 8))\\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=label_encoder.classes_, yticklabels=label_encoder.classes_)\\n",
    "    plt.title(f'{name} - Confusion Matrix')\\n",
    "    plt.ylabel('True')\\n",
    "    plt.xlabel('Predicted')\\n",
    "    plt.xticks(rotation=45, ha='right')\\n",
    "    plt.yticks(rotation=0)\\n",
    "    plt.tight_layout()\\n",
    "    plt.show()\\n",
    "    return {'accuracy': acc, 'precision': prec, 'recall': rec, 'f1_score': f1}\\n",
    "\\n",
    "rf_metrics = eval_model(rf_model, X_test, y_test_encoded, \\"Random Forest\\")\\n",
    "xgb_metrics = eval_model(xgb_model, X_test, y_test_encoded, \\"XGBoost\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 13: Select Best Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\\"\\\\n{'='*70}\\")\\n",
    "print(\\"Model Comparison\\")\\n",
    "print(f\\"{'='*70}\\\\n\\")\\n",
    "comparison_df = pd.DataFrame({\\n",
    "    'Model': ['Random Forest', 'XGBoost'],\\n",
    "    'Accuracy': [rf_metrics['accuracy'], xgb_metrics['accuracy']],\\n",
    "    'F1-Score': [rf_metrics['f1_score'], xgb_metrics['f1_score']]\\n",
    "})\\n",
    "print(comparison_df.to_string(index=False))\\n",
    "print()\\n",
    "if xgb_metrics['f1_score'] > rf_metrics['f1_score']:\\n",
    "    best_model, best_name, best_type, best_metrics = xgb_model, 'XGBoost', 'xgboost', xgb_metrics\\n",
    "else:\\n",
    "    best_model, best_name, best_type, best_metrics = rf_model, 'Random Forest', 'random_forest', rf_metrics\\n",
    "print(f\\"🏆 Best Model: {best_name}\\")\\n",
    "print(f\\"   Accuracy: {best_metrics['accuracy']:.2%}\\")\\n",
    "print(f\\"   F1-Score: {best_metrics['f1_score']:.2%}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 14: Save Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "output_dir = Path('/content/trained_models/v2.0.0')\\n",
    "output_dir.mkdir(parents=True, exist_ok=True)\\n",
    "joblib.dump(best_model, output_dir / 'model.pkl')\\n",
    "joblib.dump(label_encoder, output_dir / 'label_encoder.pkl')\\n",
    "with open(output_dir / 'features.json', 'w') as f:\\n",
    "    json.dump(feature_columns, f, indent=2)\\n",
    "metadata = {'version': '2.0.0', 'model_type': best_type, 'trained_at': datetime.now().isoformat(), 'num_features': len(feature_columns), 'categories': list(label_encoder.classes_), 'training_samples': len(X_train), 'test_samples': len(X_test), 'metrics': best_metrics}\\n",
    "with open(output_dir / 'metadata.json', 'w') as f:\\n",
    "    json.dump(metadata, f, indent=2)\\n",
    "print(f\\"✅ Model saved to {output_dir}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 15: Download Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import shutil\\n",
    "shutil.make_archive('/content/trained_model_v2.0.0', 'zip', '/content/trained_models')\\n",
    "files.download('/content/trained_model_v2.0.0.zip')\\n",
    "print(\\"✅ Download started!\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 16: Test Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"🧪 Testing with 5 random samples:\\\\n\\")\\n",
    "for idx in np.random.choice(len(X_test), 5, replace=False):\\n",
    "    sample = X_test[idx:idx+1]\\n",
    "    true_label = label_encoder.classes_[y_test_encoded[idx]]\\n",
    "    pred_idx = best_model.predict(sample)[0]\\n",
    "    pred_label = label_encoder.classes_[pred_idx]\\n",
    "    confidence = best_model.predict_proba(sample)[0][pred_idx]\\n",
    "    cookie = test_df.iloc[idx]\\n",
    "    print(f\\"Cookie: {cookie['cookie_name']} | Domain: {cookie['cookie_domain']}\\")\\n",
    "    print(f\\"  True: {true_label} | Predicted: {pred_label} ({confidence:.1%}) {'✅' if pred_label==true_label else '❌'}\\\\n\\")\\n",
    "print(f\\"\\\\n🎉 Complete! Best: {best_name} | Accuracy: {best_metrics['accuracy']:.2%}\\")"
   ]
  }
 ]
}

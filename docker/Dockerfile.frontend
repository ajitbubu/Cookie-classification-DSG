FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:5173 || exit 1

# Run dev server — proxy /api to the API container via VITE_API_URL env var
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

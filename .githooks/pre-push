#!/usr/bin/env bash
#
# Pre-push gate: lint, frontend tests and backend tests must pass before a push.
# Enabled by `npm install` (package.json "prepare" sets core.hooksPath=.githooks).
# GitHub Actions (.github/workflows/ci.yml) runs the same checks on every PR and
# push to main, so skipping this hook (git push --no-verify) only moves the
# failure to CI.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing to check when the push only deletes refs.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] && pushing=1
done
[ "$pushing" = 1 ] || exit 0

# The checks run on the working tree, so it must match what is being pushed.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "pre-push: you have uncommitted changes. Commit or stash them so the checks test what you push." >&2
  exit 1
fi

step() { printf '\n▶ %s\n' "$1"; }
fail() { printf '\n✖ pre-push: %s failed — push blocked.\n' "$1" >&2; exit 1; }

step "Lint (npm run lint)"
npm run -s lint || fail "lint"

step "Frontend tests (npm test)"
npm test || fail "frontend tests"

step "Backend tests (tests/run_api_tests.sh, in the API Docker image)"
if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop and push again." >&2
  fail "backend tests"
fi
bash tests/run_api_tests.sh || fail "backend tests"

printf '\n✔ pre-push: all checks passed.\n'
